From 1e7d69d79b3d829fd40f7f30d1a7ae38484f71b2 Mon Sep 17 00:00:00 2001
From: Zuher <zuher5@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:59:17 +0700
Subject: [PATCH] Toggle for allowing app links to open in external apps

Add a 'Allow app links to open in apps' switch under Privacy and security.
When disabled, navigations handing off a web page to an installed app
(app links, link capturing, intent:// and other custom schemes) are kept
in the browser. Plain protocol handlers (tel:, mailto:, sms:, geo:) keep
working. The 'Open in App' entry points are hidden while disabled.
---
 .../ExternalNavigationDelegateImpl.java       | 26 ++++++++++++++++++-
 .../browser/open_in_app/OpenInAppUtils.java   |  2 ++
 .../shared_preferences/SharedPrefsUtils.java  |  5 +++-
 .../java/res/xml/privacy_preferences_ext.xml  |  5 ++++
 .../privacy/settings/PrivacySettingsExt.java  | 16 ++++++++++++
 .../strings/android_chrome_ext_strings.grdp   |  6 +++++
 6 files changed, 58 insertions(+), 2 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/externalnav/ExternalNavigationDelegateImpl.java b/chrome/android/java/src/org/chromium/chrome/browser/externalnav/ExternalNavigationDelegateImpl.java
index f29b082..a64d3da 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/externalnav/ExternalNavigationDelegateImpl.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/externalnav/ExternalNavigationDelegateImpl.java
@@ -33,6 +33,7 @@ import org.chromium.chrome.browser.document.ChromeLauncherActivity;
 import org.chromium.chrome.browser.glic.GlicEnabling;
 import org.chromium.chrome.browser.open_in_app.OpenInAppDelegate;
 import org.chromium.chrome.browser.open_in_app.OpenInAppUtils;
+import org.chromium.base.shared_preferences.SharedPrefsUtils;
 import org.chromium.chrome.browser.password_manager.CctPasswordSavingMetricsRecorderBridge;
 import org.chromium.chrome.browser.profiles.Profile;
 import org.chromium.chrome.browser.tab.Tab;
@@ -143,7 +144,30 @@ public class ExternalNavigationDelegateImpl implements ExternalNavigationDelegat
     @Override
     public boolean shouldDisableExternalIntentRequestsForUrl(
             ExternalNavigationParams params, Intent intent) {
-        return false;
+        if (SharedPrefsUtils.SharedPrefsExt.ALLOW_APP_LINKS.get()) return false;
+        return isAppLinkNavigation(params.getUrl(), intent);
+    }
+
+    /**
+     * Returns whether the navigation hands off a web page to an installed app (app links, link
+     * capturing, intent:// or other custom schemes). Plain protocol handlers like tel:, mailto:,
+     * sms: and geo: are exempt so that they keep working when opening app links in external apps
+     * is disabled by the user.
+     */
+    private static boolean isAppLinkNavigation(GURL url, Intent intent) {
+        String scheme = url.isValid() ? url.getScheme() : "";
+        if (scheme.isEmpty() && intent.getData() != null) {
+            scheme = intent.getData().getScheme();
+        }
+        switch (scheme) {
+            case UrlConstants.TEL_SCHEME:
+            case UrlConstants.SMS_SCHEME:
+            case "mailto":
+            case "geo":
+                return false;
+            default:
+                return true;
+        }
     }
 
     @Override
diff --git a/chrome/browser/open_in_app/android/java/src/org/chromium/chrome/browser/open_in_app/OpenInAppUtils.java b/chrome/browser/open_in_app/android/java/src/org/chromium/chrome/browser/open_in_app/OpenInAppUtils.java
